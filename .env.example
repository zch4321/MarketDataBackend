# Example .env for local development. Copy to .env (which is gitignored) and
# fill in real values. Variables already set in the real environment are NOT
# overridden by .env, so platform-injected secrets always win.
#
# The .env file is loaded at startup; its values feed both ${VAR} expansion in
# config.yaml and direct environment overrides.

# Docker Compose dependency versions and host ports.
POSTGRES_IMAGE=postgres:18
POSTGRES_USER=marketdata
POSTGRES_PASSWORD=marketdata
POSTGRES_DB=marketdata
POSTGRES_PORT=55432

KAFKA_IMAGE=apache/kafka:4.3.0
KAFKA_PORT=19092
KAFKA_BROKERS=127.0.0.1:19092
TEST_KAFKA_BROKERS=127.0.0.1:19092

# Secret referenced by config.example.yaml's database.dsn.
DB_PASSWORD=marketdata

# Application and integration-test connections from the host.
DATABASE_DSN=postgres://marketdata:marketdata@127.0.0.1:55432/marketdata?sslmode=disable
TEST_DATABASE_DSN=postgres://marketdata:marketdata@127.0.0.1:55432/marketdata?sslmode=disable
